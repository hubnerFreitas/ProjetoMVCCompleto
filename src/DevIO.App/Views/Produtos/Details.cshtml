@model DevIO.App.ViewModels.ProdutoViewModel

@{
    ViewData["Title"] = "Detalhes do " + Model.Nome;
}
<h1 style="padding-top: 50px;">@ViewData["Title"]</h1>

<hr />
<div clas="row">
    <div class="col-md-4">
        <img src="~/imagens/@Model.Imagem" alt="@Model.Nome" style="width: 300px; height: 400px;" />
    </div>
    <div class="col-md-6">
        <dl>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.FornecedorId)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Fornecedor.Nome)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Nome)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Descricao)
            </dd>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Valor)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Ativo)
            </dt>
        </dl>

        <div>
            <a class="btn btn-dark" asp-action="Edit" asp-route-id="@Model?.Id">Edit</a>
            <a class="btn btn-info" asp-action="javascript:window.history.back();">Back to List</a>
        </div>
    </div>
</div>
